# This value is the name of your application.
APP_NAME='Social Hub'

# Key used to encrypt and decrypt sensitive data. Generate it with: php artisan key:generate
APP_KEY=

# Debug mode setting. Set to 'false' for production environments.
APP_DEBUG=false

# Full application URL. Important: it is not allowed to be a slash at the end of the url.
APP_URL=http://localhost:8100

# MySQL connection setup
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=social_hub
DB_USERNAME=root
DB_PASSWORD=

# Redis connection setup
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The disk on which to store uploaded media (the variable name comes from the Mixpost core). Disks: "public", "s3". For "s3" you should fill in the AWS_* credentials below.
MIXPOST_DISK=public

# AWS Credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"